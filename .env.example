# Configuration for Huallaga AI Monitor

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-5.6-luna
IMAGE_DETAIL=auto
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx

# Camera Configuration
CAMERA_SOURCE=0
CAMERA_FPS=30
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# YOLO Local Detector Configuration
YOLO_MODEL=yolov8n.pt
YOLO_PERSON_CONFIDENCE=0.50

# Temporal Buffer & Event Configuration
BUFFER_SECONDS=5
BUFFER_FPS=5
EVENT_CAPTURE_SECONDS=3
EVENT_COOLDOWN_SECONDS=10

# Frame Processing & Multimodal AI Options
FRAMES_PER_ANALYSIS=5
IMAGE_MAX_WIDTH=1280
JPEG_QUALITY=70

# Decision Engine Thresholds
AI_WARNING_THRESHOLD=0.80

# System Settings
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
