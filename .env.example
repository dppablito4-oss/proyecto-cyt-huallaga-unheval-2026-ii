# Configuración de SIVARH

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_VISION_REASONING_EFFORT=none
IMAGE_DETAIL=low
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
OPENAI_TTS_SPEED=1.1
OPENAI_TTS_RESPONSE_FORMAT=pcm
OPENAI_TTS_STREAM_BUFFER_MS=400
USE_LOCAL_WARNING_AUDIO=True
OPENAI_TTS_FALLBACK_ENABLED=True
LOCAL_WARNING_MESSAGE=Cuidemos juntos el Huallaga. Por favor, recoge el residuo y deposítalo en un contenedor.
LOCAL_WARNING_AUDIO_PATH=data/audio/templates/warning_default.wav
TTS_CACHE_DIR=data/audio/cache

# Camera Configuration
CAMERA_SOURCE=0
CAMERA_ID=CAM_001
CAMERA_FPS=30
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# YOLO Local Detector Configuration
DETECTOR_BACKEND=yoloe
YOLO_MODEL=yoloe-26n-seg.pt
YOLO_PROMPT_EMBEDDINGS_PATH=data/models/sivarh-yoloe-26n-prompts.npz
YOLO_IMGSZ=640
DETECTION_FPS=5
# Legacy fallback used when DETECTION_CONFIDENCE is absent
YOLO_PERSON_CONFIDENCE=0.50
DETECTION_CONFIDENCE=0.20
DETECTION_CLASSES=person,plastic bag,trash bag,garbage bag,bottle,cup,food wrapper,cardboard box,backpack,handbag

# Anonymous Multi-Object Tracking (SIVARH v2)
TRACKING_ENABLED=True
TRACKER_TYPE=bytetrack
TRACK_HISTORY_SECONDS=15
TRACK_TTL_SECONDS=5
TRACK_ACTIVATION_THRESHOLD=0.20
TRACK_LOST_BUFFER=30
TRACK_MIN_CONSECUTIVE_FRAMES=2
TRACK_MIN_IOU_THRESHOLD=0.10

# Spatial scene and optional stream overlay (SIVARH v2)
ZONE_CONFIG_PATH=config/zones.json
VISION_DEBUG_OVERLAY=False

# Person-object association with optional pose signal (SIVARH v2)
ASSOCIATION_ENABLED=True
ASSOCIATION_MIN_SCORE=0.65
ASSOCIATION_MIN_DURATION=0.5
ASSOCIATION_BBOX_WEIGHT=0.35
ASSOCIATION_CENTROID_WEIGHT=0.25
ASSOCIATION_TRAJECTORY_WEIGHT=0.25
ASSOCIATION_TEMPORAL_WEIGHT=0.15
ASSOCIATION_HAND_WEIGHT=0.25
ASSOCIATION_MAX_DISTANCE_RATIO=1.5
ASSOCIATION_HAND_DISTANCE_RATIO=0.5
ASSOCIATION_TRAJECTORY_POINTS=5

# Selective MediaPipe Pose (optional extra: pip install -r requirements-pose.txt)
POSE_ENABLED=False
POSE_MODEL_PATH=data/models/pose_landmarker_lite.task
POSE_FPS=7
POSE_MIN_PERSON_CONFIDENCE=0.60
POSE_MIN_DETECTION_CONFIDENCE=0.50
POSE_MIN_LANDMARK_VISIBILITY=0.50
POSE_TRIGGER_ZONES=observation,riverbank,river_edge,water
POSE_MAX_PERSONS_PER_FRAME=2
POSE_RESULT_TTL_SECONDS=0.5
POSE_CROP_PADDING_RATIO=0.15
POSE_OBJECT_PROXIMITY_RATIO=0.5

# Local temporal reasoning and EventCandidate trigger (Phases 6-7)
OBJECT_CARRIED_SCORE=0.70
OBJECT_CARRIED_SECONDS=0.5
OBJECT_RELEASE_SCORE=0.35
OBJECT_RELEASE_GRACE_SECONDS=0.3
OBJECT_LOST_RELEASE_SECONDS=0.35
OBJECT_STATIONARY_SECONDS=2.0
OBJECT_STATIONARY_MAX_DISTANCE_PX=12.0
OBJECT_STATE_TTL_SECONDS=10.0
PERSON_MOVING_AWAY_SECONDS=1.0
PERSON_MOVING_AWAY_MIN_DISTANCE_PX=30.0
OBJECT_THROW_MIN_SPEED_PX_S=90.0
OBJECT_THROW_MIN_DISTANCE_PX=24.0
EVENT_RELEVANT_ZONES=riverbank,river_edge,water
LOCAL_IGNORE_THRESHOLD=0.35
LOCAL_CONFIRM_THRESHOLD=0.75
EVENT_CARRIED_WEIGHT=0.25
EVENT_RELEASE_WEIGHT=0.25
EVENT_TARGET_ZONE_WEIGHT=0.20
EVENT_STATIONARY_WEIGHT=0.15
EVENT_MOVING_AWAY_WEIGHT=0.15
EVENT_THROW_WEIGHT=0.25

# OpenAI verification fallback and event-oriented keyframes (Phase 8)
OPENAI_FALLBACK_ENABLED=True
OPENAI_MAX_FRAMES=3
EVENT_MIN_CONTEXT_SECONDS=2.2
EVENT_KEYFRAME_BEFORE_SECONDS=1.0
EVENT_KEYFRAME_AFTER_SECONDS=1.0
METRICS_WINDOW_SECONDS=10.0
PERFORMANCE_LOG_INTERVAL_SECONDS=10.0

# Temporal Buffer & Event Configuration
BUFFER_SECONDS=6
BUFFER_FPS=5
EVENT_CAPTURE_SECONDS=5.6
SEQUENCE_FRAME_INTERVAL_SECONDS=0.8
EVENT_COOLDOWN_SECONDS=20
MANUAL_RECOGNITION_MODE=True
MANUAL_CAPTURE_FRAMES=4
MANUAL_CAPTURE_INTERVAL_SECONDS=1.5

# Frame Processing & Multimodal AI Options
FRAMES_PER_ANALYSIS=7
IMAGE_MAX_WIDTH=960
JPEG_QUALITY=70

# Decision Engine Thresholds
AI_WARNING_THRESHOLD=0.80

# System Settings
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000
